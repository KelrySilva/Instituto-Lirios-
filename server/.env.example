# Copie este arquivo para .env e ajuste conforme o seu MySQL
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=instituto_lirios

# Deixe * em desenvolvimento. Em produção, informe a origem do site.
CORS_ORIGIN=*

# Resumo inteligente (IA). Sem chave, o sistema gera um resumo básico (sem IA).
# NUNCA envie o arquivo .env para o GitHub.
#
# Opção gratuita: Google Gemini. Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# Opção paga (opcional): Claude. Chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
