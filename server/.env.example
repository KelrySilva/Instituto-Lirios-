# Copie este arquivo para .env e ajuste conforme o seu MySQL
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=instituto_lirios

# Deixe * em desenvolvimento. Em produção, informe a origem do site.
CORS_ORIGIN=*

# Resumo inteligente (IA). Sem chave, o sistema gera um resumo básico (sem IA).
# NUNCA envie o arquivo .env para o GitHub.
#
# Opção gratuita: Google Gemini. Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# Opção paga (opcional): Claude. Chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Login (token) ---------------------------------------------------------
# Segredo que assina os tokens. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# e cole aqui no seu .env (NUNCA no .env.example, que vai para o GitHub).
AUTH_SECRET=
# Por quantas horas o login vale (padrão 8).
TOKEN_HORAS=8

# --- E-mail (recuperação de senha) -----------------------------------------
# Conta que ENVIA as mensagens. Com Gmail: ative a verificação em duas etapas e
# crie uma "senha de app" em https://myaccount.google.com/apppasswords
# (use essa senha de 16 letras aqui, NUNCA a senha normal do e-mail).
# Teste depois com:  node testar-email.js seu@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Nome que aparece como remetente (opcional). Ex.: Instituto Lírios <conta@gmail.com>
SMTP_FROM=
# Endereço onde o sistema (as telas) abre no navegador. O link do e-mail usa isto.
# Ex.: http://localhost:8080  ou  https://sistema.seudominio.com.br
APP_URL=http://localhost:8080

# --- Backup (veja "Backup do banco" no README) -------------------------------
# Caminho do mysqldump, se o sistema não o encontrar sozinho (Windows):
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
# Segunda pasta que recebe uma cópia de cada backup (pen drive, OneDrive, HD externo):
# BACKUP_COPIAR_PARA=D:\backup-lirios
# Quantos backups guardar (padrão 30):
# BACKUP_MANTER=30
